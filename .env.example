# =================================================================
# Enterprise Knowledge Agent - Environment Configuration Example
# =================================================================
# Copy this file to .env and fill in your credentials:
# cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. ENTERPRISE DATA CONNECTORS
# -----------------------------------------------------------------

# GitHub Connector (Personal Access Token / Fine-grained Token)
# Permissions: repo, read:org
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Notion Connector (Internal Integration Token: secret_... or ntn_...)
# Create at: https://app.notion.com/developers/connections
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_PAGE_ID=2fb3317c-c712-8028-80ea-cdca6646fe1e

# Dropbox Connector (App key, App secret, Refresh token or short-lived token)
# Create at: https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token

# Atlassian Confluence
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_API_TOKEN=your_confluence_api_token

# Atlassian Jira
# JIRA_URL must point to your site (e.g. https://your-org.atlassian.net), not https://home.atlassian.com
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Google Drive / Workspace
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json


# -----------------------------------------------------------------
# 2. LLM PROVIDER & AGENT REASONING (Swappable Cloud / Local)
# -----------------------------------------------------------------
# Active Provider: "gemini" (cloud) | "ollama" (local private)
LLM_PROVIDER=gemini

# Option A: Google Gemini API (Default for cloud agent & tool calling)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Option B: Ollama (Local LLM server for zero data-leakage private deployment)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434


# -----------------------------------------------------------------
# 3. LOCAL EMBEDDINGS & RERANKER (In-Process, Zero API Cost)
# -----------------------------------------------------------------
# Embedding Provider: "local" (sentence-transformers)
EMBEDDING_PROVIDER=local
# Default: Qwen/Qwen3-Embedding-0.6B (Options: Qwen/Qwen3-Embedding-4B, BAAI/bge-m3)
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Reranker Provider: "local" (cross-encoder)
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2


# -----------------------------------------------------------------
# 4. VECTOR DATABASE (Qdrant with Metadata & RBAC Pre-Filtering)
# -----------------------------------------------------------------
# Mode: "local" (in-process SQLite/storage) | "server" (Docker / Cloud)
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant_storage
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_if_cloud
QDRANT_COLLECTION=enterprise_knowledge


# -----------------------------------------------------------------
# 5. KNOWLEDGE GRAPH DATABASE (Neo4j for Graph RAG)
# -----------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
